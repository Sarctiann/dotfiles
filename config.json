{
  "system_packages": ["tmux", "git", "zsh", "xclip", "chafa"],
  "conditional_system_packages": {
    "luarocks": ["zsh"]
  },
  "base_steps": ["System packages", "Fonts", "Stow symlinks"],
  "cli_tools": {
    "neovim": {
      "repo": "neovim/neovim",
      "binary": "nvim",
      "asset_pattern": null
    },
    "ripgrep": {
      "repo": "BurntSushi/ripgrep",
      "binary": "rg",
      "asset_pattern": null
    },
    "fd": { "repo": "sharkdp/fd", "binary": "fd", "asset_pattern": null },
    "bat": { "repo": "sharkdp/bat", "binary": "bat", "asset_pattern": null },
    "lazygit": {
      "repo": "jesseduffield/lazygit",
      "binary": "lazygit",
      "asset_pattern": null
    },
    "lazydocker": {
      "repo": "jesseduffield/lazydocker",
      "binary": "lazydocker",
      "asset_pattern": null
    },
    "lazysql": {
      "repo": "jorgerojas26/lazysql",
      "binary": "lazysql",
      "asset_pattern": null
    },
    "gh": { "repo": "cli/cli", "binary": "gh", "asset_pattern": null },
    "fzf": { "repo": "junegunn/fzf", "binary": "fzf", "asset_pattern": null },
    "yazi": { "repo": "sxyazi/yazi", "binary": "yazi", "asset_pattern": null },
    "ruff": {
      "repo": "astral-sh/ruff",
      "binary": "ruff",
      "asset_pattern": null
    }
  },
  "terminal_font": "CodeNewRoman",
  "runtimes": {
    "nvm": true,
    "bun": true,
    "rust": true,
    "opencode": true,
    "uv": true
  },
  "stow": {
    "enabled": true,
    "ghostty_or_windowsTerminal": true,
    "alacritty": false,
    "wezterm": false,
    "base": ["local-bin"],
    "deps": {
      "zsh": ["lazyvim", "opencode", "mojo"],
      "tmux": ["zsh"],
      "ghostty": ["tmux", "zsh"],
      "alacritty": ["tmux", "zsh"],
      "wezterm": ["tmux", "zsh"],
      "windows-terminal": ["tmux", "zsh"],
      "lazyvim": ["opencode"],
      "opencode": ["lazyvim"],
      "bat": [],
      "mojo": [],
      "augment": [],
      "gemini": [],
      "local-bin": [],
      "lazygit": [],
      "lazydocker": [],
      "yazi": ["zsh", "bat"]
    }
  },
  "step_deps": {
      "CLI tools": ["lazyvim", "bat"],
      "NPM packages": ["lazyvim", "zsh"],
      "Runtimes": ["lazyvim", "opencode", "zsh"],
    "Post-install": ["tmux", "windows-terminal"]
  },
  "post_install": {
    "tpm": true
  },
  "npm_packages": {
    "auggie": {
      "package": "@augmentcode/auggie",
      "binary": "auggie"
    },
    "gemini": {
      "package": "@google/gemini-cli",
      "binary": "gemini"
    }
  },
  "verify": {
    "essential": [
      "stow",
      "nvim",
      "tmux",
      "rg",
      "fd",
      "bat",
      "gh",
      "git",
      "zsh"
    ],
    "optional": [
      "lazygit",
      "lazydocker",
      "lazysql",
      "yazi",
      "nvm",
      "bun",
      "cargo",
      "opencode",
      "uv",
      "auggie",
      "gemini"
    ]
  }
}

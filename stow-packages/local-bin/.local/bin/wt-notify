#!/usr/bin/env bash
# Shows a popup on the monitor where Windows Terminal is (Windows toasts only appear on the primary display).
# Popups shown at the same time stack upwards; each one shows the time it appeared. Click one to dismiss it.
# Usage: wt-notify TITLE [BODY] [ACCENT_HEX]       Test: WT_NOTIFY_FOREGROUND=1 wt-notify "Hola" "Prueba"
# Env: WT_NOTIFY_SECONDS (default 8), WT_NOTIFY_SOUND=0 to mute, WT_NOTIFY_SOUND_FILE for another .wav
# (default ~/.local/share/wt-notify/woodblock.wav), WT_NOTIFY_FOREGROUND=1 to wait and show
# PowerShell errors, WT_NOTIFY_POWERSHELL to use another powershell.exe, WT_NOTIFY_PRELUDE for PowerShell code
# run first in the same process (it can `exit` to skip the popup).
# Returns immediately unless WT_NOTIFY_FOREGROUND=1; the popup lives in a detached PowerShell.

# Disabled: launching powershell.exe from WSL raised malware alerts with the company's IT security.
exit 0

title="${1:-Notificación}"
body="${2:-}"
accent="${3:-#D97757}"
[[ "$accent" =~ ^#[0-9A-Fa-f]{6}$ ]] || accent="#D97757"
seconds="${WT_NOTIFY_SECONDS:-8}"
[[ "$seconds" =~ ^[0-9]+$ ]] || seconds=8
sound='$true'
[ "${WT_NOTIFY_SOUND:-1}" = 0 ] && sound='$false'
# Sound: a dry wood-block knock (any .wav works); the popup falls back to Windows' Asterisk sound without it.
sound_file="${WT_NOTIFY_SOUND_FILE:-$HOME/.local/share/wt-notify/woodblock.wav}"
win_sound_file=""
[ -f "$sound_file" ] && win_sound_file="$(wslpath -w "$sound_file" 2>/dev/null)"

popup="$HOME/.local/share/wt-notify/popup.ps1"
[ -f "$popup" ] || popup="$(dirname "$(realpath "$0")")/../share/wt-notify/popup.ps1"
[ -f "$popup" ] || { echo "wt-notify: popup.ps1 not found" >&2; exit 1; }

PS="${WT_NOTIFY_POWERSHELL:-/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe}"
[ -x "$PS" ] || PS="$(command -v powershell.exe || true)"
[ -n "$PS" ] || exit 0

ps_escape() { printf '%s' "${1//\'/\'\'}"; }
clean() { printf '%s' "$*" | tr -s '[:space:]' ' '; }

# The values go inside the script itself (EncodedCommand is UTF-16), so accents survive the WSL -> Windows hop.
script="${WT_NOTIFY_PRELUDE:-}
\$Title = '$(ps_escape "$(clean "$title")")'
\$Body = '$(ps_escape "$(clean "$body")")'
\$Accent = '$accent'
\$Seconds = $seconds
\$Sound = $sound
\$SoundFile = '$(ps_escape "$win_sound_file")'
$(cat "$popup")"

encoded="$(printf '%s' "$script" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)"

if [ "${WT_NOTIFY_FOREGROUND:-0}" = 1 ]; then
  exec "$PS" -NoProfile -NonInteractive -EncodedCommand "$encoded"
fi
setsid "$PS" -NoProfile -NonInteractive -EncodedCommand "$encoded" >/dev/null 2>&1 &
exit 0

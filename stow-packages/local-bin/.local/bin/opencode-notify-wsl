#!/usr/bin/env bash
# Called by opencode-notifier's command hook: rings the terminal bell of the OpenCode that ran it, as if OpenCode
# rang it. An nvim :terminal passes it on (belloff without "term"), tmux marks the window in the status bar and
# its alert-bell hook forwards it to other sessions, and Windows Terminal plays the sound.
# The plugin's own "bell" option writes to the plugin process' stdout, which didn't reach OpenCode's terminal.
# Everything stays inside WSL: launching powershell.exe from WSL raised malware alerts with IT security.
# Arguments ({message} {projectName}) are ignored.

# Walk up from this process to the first ancestor whose stdin is a terminal: OpenCode's TUI.
pid=$$
while [ "${pid:-0}" -gt 1 ]; do
  tty="$(readlink "/proc/$pid/fd/0" 2>/dev/null)"
  case "$tty" in
    /dev/pts/*) printf '\a' > "$tty"; exit 0 ;;
  esac
  pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
done
exit 0

          "resource": "using-neovim",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "using-quickfix",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "using-neovim-lsp",
          "effect": "allow"
        }
      ]
    },
    "z-ultra": {
      "permissions": [
        {
          "action": "skill",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "skill",
          "resource": "using-neovim",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "using-quickfix",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "using-neovim-lsp",
          "effect": "allow"
        }
      ]
    },
    "z-pilot": {
      "permissions": [
        {
          "action": "skill",
          "resource": "*",
          "effect": "ask"
        },
        {

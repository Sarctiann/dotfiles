{
  // Schema for OpenCode configuration
  "$schema": "https://opencode.ai/config.json",

  // Username for the OpenCode instance
  "username": "Sebastian",

  // Enable automatic updates
  "update": "auto",

  // Allow all actions without prompts
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],

  // Provider model filters - hide duplicates from opencode (Zen) that exist in opencode-go
  "providers": {
    "opencode": {
      "models": {
        "minimax-m2.5": { "disabled": true },
        "minimax-m2.7": { "disabled": true },
        "glm-5": { "disabled": true },
        "glm-5.1": { "disabled": true },
        "kimi-k2.5": { "disabled": true },
        "kimi-k2.6": { "disabled": true },
        "qwen3.5-plus": { "disabled": true },
        "qwen3.6-plus": { "disabled": true },
      },
    },
  },

  // Plugins to load
  "plugins": [
    "@slkiser/opencode-quota@latest",
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],

  // Agent-specific model configuration
  "agents": {
    // Built-in agents with specific models and colors
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free",
      "description": "[󰫣    | ---  | 󱐋󱐋󱐋] Fast codebase exploration at zero cost",
    },
    "general": {
      "model": "opencode/big-pickle",
      "description": "[󰫣󰫣   | ---  | 󱐋  ] Balanced general-purpose assistant",
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "max",
      "color": "#bb9af7",
      "description": "[󰫣   |    | 󱐋󱐋󱐋] Implementation specialist with precision coding",
    },
    "plan": {
      "model": "opencode-go/glm-5.3",
      "color": "#ff9e64",
      "description": "[󰫣󰫣󰫣  |   | 󱐋  ] Deep reasoning architect for multi-step planning and design",
    },
    // Custom agents with specific models and colors
    "x--free": {
      "model": "opencode/big-pickle",
      "color": "#b8db87",
      "description": "[󰫣󰫣   | ---  | 󱐋  ] Free tier model for unlimited experimentation",
      "mode": "primary",
    },
    "x-teach": {
      "model": "opencode-go/claude-haiku-5-5",
      "color": "#4fd6be",
      "description": "[󰫣    |     | 󱐋󱐋󱐋] Learning companion — doesn't code, teaches concepts and how to find answers independently",
    },
    "z-forge": {
      "model": "opencode-go/kimi-k3.1-pro",
      "color": "#007197",
      "description": "[󰫣󰫣󰫣  |   | 󱐋  ] High-precision implementation specialist",
      "permissions": [{ "action": "skill", "resource": "*", "effect": "ask" }],
    },
    "z-logic": {
      "model": "opencode-go/deepseek-v4-pro",
      "color": "#2e7de9",
      "description": "[󰫣󰫣󰫣  |    | 󱐋  ] Reasoning architect for decomposition and design decisions",
      "permissions": [{ "action": "skill", "resource": "*", "effect": "ask" }],
    },
    "z-nexus": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "color": "#9854f1",
      "description": "[󰫣    |     | 󱐋󱐋󱐋] Large-context analyzer for multi-file understanding",
      "permissions": [{ "action": "skill", "resource": "*", "effect": "ask" }],
    },
    "z-pilot": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "color": "#7aa2f7",
      "description": "[󰫣    |     | 󱐋󱐋󱐋] Tool and execution specialist for tests/builds/scripts",
      "permissions": [{ "action": "skill", "resource": "*", "effect": "ask" }],
    },
    "z-spark": {
      "model": "opencode/glm-5.3-flash-free",
      "color": "#7dcfff",
      "description": "[---  | ---  | 󱐋󱐋󱐋] Low-latency agent for quick tasks",
      "permissions": [{ "action": "skill", "resource": "*", "effect": "ask" }],
    },
    "z-ultra": {
      "model": "opencode-go/glm-5.3",
      "color": "#e26a75",
      "description": "[󰫣󰫣󰫣  |   | 󱐋  ] Heavy refactor and structural transformation specialist",
      "permissions": [{ "action": "skill", "resource": "*", "effect": "ask" }],
    },
  },

  // Commands
  "commands": {
    "audit-agents": {
      "agent": "x--free",
      "template": "Run the agent-model-audit skill to audit and optimize agent model assignments. Check if the user provided a priority mode argument: 'skill'/'ability'/'habilidad' (default) = role fit first; 'price'/'cost'/'precio'/'barato' = cost first; 'speed'/'fast'/'velocidad'/'rapido' = speed first. Use that mode throughout the optimization step. If no argument was given, default to 'skill' mode. Shared models across agents are allowed; do not enforce uniqueness. Before writing the final configuration, probe every proposed model for availability as described in the skill, and replace any unavailable model.",
      "description": "Audit and optimize agent model assignments with availability probing. Optional argument: skill (default), price, or speed",
    },
    "sync-agents": {
      "agent": "x--free",
      "template": "Run the agent-sync-neovim skill to update Neovim MCP permissions in ~/.config/nvim/lua/utils/opencode-neovim/opencode_nvim_mcps.jsonc to match the current agent definitions in opencode.jsonc.",
      "description": "Sync agent permissions to Neovim MCP config",
    },
  },

  // MCP servers configuration
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
      },
      "augment-context-engine": {
        "type": "local",
        "command": ["auggie", "--mcp", "--mcp-auto-workspace"],
        "disabled": true,
      },
      // Neovim MCP server for buffer access and editing (bigcodegen).
      // Enabled only when OpenCode is launched from Neovim: the nvim overlay
      // (opencode_nvim_mcps.jsonc, injected via OPENCODE_CONFIG) overrides `disabled`.
      "neovim": {
        "type": "local",
        "command": ["npx", "-y", "mcp-neovim-server"],
        "disabled": true,
        "environment": {
          // Enable shell commands execution through vim
          "ALLOW_SHELL_COMMANDS": "true",
          // Socket path for neovim connection (uses NVIM env var)
          "NVIM_SOCKET_PATH": "{env:NVIM}",
        },
      },
    },
  },
}

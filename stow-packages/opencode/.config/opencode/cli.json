{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "custom-tokyonight",
    "mode": "dark"
  },
  "keybinds": {
    "which-key.toggle": "<leader>k",
    "session.new": "tabn,<leader>n",
    "session.tab.close": "tabd,<leader>w",
    "session.tab.previous": "tableft,ctrl+shift+tab,alt+up",
    "session.tab.next": "tabright,ctrl+tab,alt+down"
  },
  "plugins": ["@slkiser/opencode-quota@latest", "./plugins/tabs"],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "prompt": {
    "image_preview": false
  },
  "debug": {
    "devtools": true,
    "turn_tokens": false
  },
  "experimental": {
    "client-mcp": true,
    "new-designs": true
  }
}

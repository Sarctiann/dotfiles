{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "custom-tokyonight",
    "mode": "dark"
  },
  "keybinds": {
    "which-key.toggle": "<leader>k"
  },
  "plugins": ["@slkiser/opencode-quota@latest"],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true
}

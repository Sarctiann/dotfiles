# Ghostty main configuration (shared, tracked in git)
# Machine-specific overrides live in local_config (loaded via config-file below).

# --- Theme ---
theme = "TokyoNight Night"

# --- Window ---
maximize = true
window-padding-x = 5
window-padding-y = 3
window-padding-balance = true
window-padding-color = background
adjust-cell-width = 5%
adjust-cell-height = 5%

# --- Cursor ---
cursor-style = "bar"
cursor-style-blink = false

# --- Shader ---
custom-shader = "./shaders/cursor_smear.glsl"
font-thicken = true
font-thicken-strength = 255

# --- macOS ---
macos-non-native-fullscreen = padded-notch
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-option-as-alt = left
background-opacity = 0.90
# Background blur is machine-specific and generated in local_config.

# --- Behavior ---
confirm-close-surface = false

# --- Bell ---
# Ghostty disables bell audio by default (no-system,no-audio) and `audio` with no path is silent. agent-notify
# rings the bell on the client's terminal for agent alerts; the system beep stays off to avoid doubling it.
# The sound is relative to this file (the same woodblock Windows Terminal plays).
bell-features = audio,attention,title,no-system,no-border
bell-audio-path = woodblock.wav

# --- Keybindings ---
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+enter=text:\x1b[13;5u

# Machine-specific overrides loaded AFTER this file, so they take precedence.
config-file = "./local_config"

# Ghostty main configuration (shared, tracked in git)
# Machine-specific overrides live in local_config (loaded via config-file below).

# --- Theme ---
theme = "TokyoNight Night"

# --- Window ---
maximize = true
window-padding-x = 5
window-padding-y = 3
window-padding-balance = true
window-padding-color = background
adjust-cell-width = 5%
adjust-cell-height = 5%

# --- Cursor ---
cursor-style = "bar"
cursor-style-blink = true

# --- Shader ---
custom-shader = "./shaders/cursor_smear.glsl"
font-thicken = true
font-thicken-strength = 255

# --- macOS ---
macos-non-native-fullscreen = padded-notch
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-option-as-alt = left
background-opacity = 0.90
background-blur = macos-glass-clear

# --- Behavior ---
confirm-close-surface = false

# --- Keybindings ---
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+enter=text:\x1b[13;5u

# Machine-specific overrides loaded AFTER this file, so they take precedence.
config-file = "./local_config"

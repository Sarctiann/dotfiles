# Sarctiann's configuration

# Override the default config file path to use a local config file in the current directory
# command and font-family are resolved dynamically to local_config via post_install
config-file = "./local_config"

theme = "TokyoNight Night"

maximize = true

window-padding-x = 5
window-padding-y = 3
window-padding-balance = true
window-padding-color = background

cursor-style = "bar"
cursor-style-blink = true
custom-shader =  "./shaders/cursor_smear.glsl"

confirm-close-surface = false

# Configure keybinds for sending ctrl+enter and shift+enter
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+enter=text:\x1b[13;5u


adjust-cell-width = 5%
adjust-cell-height = 5%
font-size = 13.5
font-thicken = true
font-thicken-strength = 255

background-opacity = 0.90
background-blur = 10

macos-non-native-fullscreen = padded-notch
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-option-as-alt = left


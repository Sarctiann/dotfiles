{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions":
    [
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[13;2u"
            },
            "keys": "shift+enter"
        },
        {
            "command":
            {
                "action": "copy",
                "singleLine": false
            },
            "keys": "alt+c"
        },
        {
            "command": "paste",
            "keys": "alt+v"
        }
    ],
    "alwaysShowTabs": false,
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultProfile": "{58ad8b0c-3ef0-4f6f-b9e0-6a9f16b2c8d3}",
    "launchMode": "maximizedFocus",
    "disableAnimations": true,
    "newTabMenu":
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles":
    {
        "defaults": {},
        "list":
        [
            {
                "antialiasingMode": "cleartype",
                "colorScheme": "TokyoNight",
                "commandline": "wsl.exe ~ tmux new-session -A -D -s main",
                "initialCols": 200,
                "initialRows": 60,
                "cursorHeight": 25,
                "cursorShape": "bar",
                "elevate": false,
                "font":
                {
                    "face": "JetBrainsMono Nerd Font Propo",
                    "size": 11.0,
                    "features":
                    {
                        "liga": 0
                    }
                },
                "guid": "{58ad8b0c-3ef0-4f6f-b9e0-6a9f16b2c8d3}",
                "hidden": false,
                "name": "Sarc WSL",
                "opacity": 95,
                "padding": "10",
                "scrollbarState": "hidden",
                "snapOnInput": false,
                "useAcrylic": false
            }
        ]
    },
    "schemes":
    [
        {
            "background": "#1A1B26",
            "black": "#151E1E",
            "blue": "#3A82DA",
            "brightBlack": "#404858",
            "brightBlue": "#7AA2F7",
            "brightCyan": "#7DCFFF",
            "brightGreen": "#9ECE6A",
            "brightPurple": "#BB9AF7",
            "brightRed": "#F7768E",
            "brightWhite": "#C0CAF5",
            "brightYellow": "#E0AF68",
            "cursorColor": "#C0CAF5",
            "cyan": "#5BDDED",
            "foreground": "#C0CAF5",
            "green": "#7EBE5A",
            "name": "TokyoNight",
            "purple": "#AD7AF9",
            "red": "#D7546E",
            "selectionBackground": "#2F3548",
            "white": "#A9B1D6",
            "yellow": "#C0AF68"
        }
    ],
    "showTabsInTitlebar": false,
    "showTerminalTitleInTitlebar": false,
    "theme": "dark",
    "themes": [],
    "windowingBehavior": "useAnyExisting"
}
